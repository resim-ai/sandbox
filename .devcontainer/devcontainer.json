{
	"name": "Python 3",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
	"mounts": [
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
		"source=root-home,target=/root,type=volume"
	],
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/guiyomh/features/just:0": {},
		"ghcr.io/trunk-io/devcontainer-feature/trunk:1": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/devcontainers/features/aws-cli:1": {}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"esbenp.prettier-vscode",
				"github.vscode-github-actions",
				"trunk.io"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python"
			}
		}
	},

	"remoteEnv": {
    // localWorkspaceFolder is the host directory which is needed for volume mount commands from inside the container
		"HOST_PROJECT_PATH": "${localWorkspaceFolder}"
	},
	
	"postCreateCommand": "apt install -y python3-pip python3-virtualenv"
}